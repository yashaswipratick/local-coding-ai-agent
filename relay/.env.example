# Google OAuth client ID from Google Cloud (Desktop application type)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Only this exact verified Google account is allowed to use the local relay.
ALLOWED_GOOGLE_EMAIL=your-email@gmail.com

# Optional: lock browser requests to this unpacked extension origin after loading it.
# EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Local target project and Python MCP server.
# PROJECT_ROOT=/absolute/path/to/your/project
# MCP_PYTHON=/absolute/path/to/local-coding-ai-agent/mcp-server/.venv/bin/python
# RELAY_PORT=8787
